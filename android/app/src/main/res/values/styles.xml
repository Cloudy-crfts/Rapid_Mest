<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Rapid Mesh Dark Theme - Instagram Style -->
    <style name="Theme.RapidMesh.Dark" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#7B68EE</item>
        <item name="colorPrimaryDark">#000000</item>
        <item name="colorAccent">#9370DB</item>
        <item name="android:windowBackground">#121212</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        
        <!-- Text Colors -->
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B3B3B3</item>
        
        <!-- Remove splash screen -->
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.RapidMesh.Splash" parent="Theme.RapidMesh.Dark">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
