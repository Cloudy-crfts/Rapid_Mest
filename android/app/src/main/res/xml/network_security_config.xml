<?xml version="1.0" encoding="utf-8"?>
<!--
    RAPID MESH - NETWORK SECURITY CONFIG
    =====================================

    System certificates are trusted so the home-screen ad banner
    (Google AdMob, HTTPS only) can load. Everything else about the
    app stays Bluetooth-only.

    Cleartext (HTTP) traffic remains BLOCKED app-wide — any network
    call that does happen must be encrypted (HTTPS).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- System CAs: required for the ad banner's HTTPS calls -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
